{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/sac/*.js": {
      "maxDuration": 60
    },
    "api/marketing/canales.js": {
      "maxDuration": 60
    },
    "api/bodega-despachos.js": {
      "maxDuration": 300
    },
    "api/ventas/flash.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/marketing/mantener-supabase",
      "schedule": "0 12 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/bodega/despachos",
      "destination": "/api/bodega-despachos"
    },
    {
      "source": "/api/marketing/(brevo-webhook|mantener-supabase|mailing/.*|redes/.*)",
      "destination": "/api/marketing/canales?ruta=$1"
    },
    {
      "source": "/api/ventas/(flash-altas|flash-preofertas|tipo-cambio)",
      "destination": "/api/ventas/flash?ruta=$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
