{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/marketing/redes.js": {
      "includeFiles": "server/marketingRedes/datos/**"
    },
    "api/sac/*.js": {
      "maxDuration": 60
    },
    "api/bodega-despachos.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/bodega/despachos",
      "destination": "/api/bodega-despachos"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
