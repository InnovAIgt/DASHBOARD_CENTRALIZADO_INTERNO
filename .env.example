# Runtime / Docker / Coolify
PORT=
NODE_ENV=

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# ==============================================================================
# SECRETS & VARIABLES PARA COOLIFY / DOCKER / VERCEL (RED INTELFON DASHBOARDS)
# Configura estas variables en Coolify (Environment Variables) o en Vercel
# ==============================================================================

# --- 1. SAP API (Facturación por línea, Inventario Bodega, Órdenes de compra) ---
VITE_SAP_API_KEY=
SAP_API_KEY=
VITE_SAP_API_URL=

# --- 2. Workflow RED API (Ventas Flash de Altas, Flujo de Activación / Radicaciones) ---
VITE_WORKFLOW_API_KEY=
WORKFLOW_API_KEY=
VITE_WORKFLOW_API_URL=

# --- 3. Marketing & CRM (Flujo de Ventas Supabase & RRSS) ---
# Flujo de ventas v2 (docs/marketing/README.md). Solo servidor: NO usar prefijo VITE_.
RED_API_KEY=
VITE_MARKETING_SUPABASE_URL=
VITE_MARKETING_SUPABASE_KEY=
VITE_MARKETING_RRSS_URL=
VITE_FX_URL=

# --- 4. Store Clientes (Cumplimiento de Clientes Supabase) ---
VITE_CLIENTES_SUPABASE_URL=
VITE_CLIENTES_SUPABASE_KEY=

# --- 5. Servicio al Cliente (SAC) Supabase Functions ---
# SOLO servidor (sin VITE_), opcionales: el portal las pide por /api/sac/corte, /api/sac/vivo y
# /api/sac/historico (server/sacProxy.js). Vacías = se usa la dirección actual de cada función.
SAC_CORTE_URL=
SAC_VIVO_URL=
SAC_HIST_URL=

# --- 6. Recursos Humanos Supabase Functions ---
VITE_RRHH_VIVO_URL=

# --- 7. SIMs por Plan (MSO API Proxy) ---
VITE_SIMS_API_BASE=

# --- 8. Campañas de Correo & Brevo ---
VITE_BREVO_API_KEY=
BREVO_API_KEY=
# Canales de marketing (docs/marketing/v2/MAILING.md, 10.1 y 10.2). SOLO servidor: NO usar prefijo VITE_.
# Clave que Brevo manda en cada aviso del webhook (POST /api/marketing/brevo-webhook).
BREVO_WEBHOOK_SECRET=
# Proyecto Supabase «Dashboard Canales de marketing» (eventos del webhook y cargo por campaña).
MKT_SUPABASE_URL=
MKT_SUPABASE_SECRET_KEY=
# Mostrar correos en el detalle de Mailing (vacío o «si» = se muestran; «no» = solo conteos). Decisión en
# docs/marketing/v2/DECISIONES.md.
MKT_MOSTRAR_CORREOS=
# Clave de Marketing para guardar cargo y objetivo en «Cargo y objetivo» (sin inicio de sesión). SOLO servidor: sin
# VITE_. Vacía = Guardar deshabilitado. Decisión en docs/marketing/v2/DECISIONES.md.
MKT_CLAVE_EDICION=
# Cumplimiento de Clientes: SOLO LECTURA (CLAUDE.md). Contraseña de la base; la conexión (pooler, puerto 6543)
# la arma el servidor en modo solo lectura (server/clientes/cumplimiento.js). CC_DB_HOST es opcional.
CC_DB_PASSWORD=
CC_DB_HOST=
# Clave que Vercel manda al cron diario /api/marketing/mantener-supabase (Supabase Free no se pausa). SOLO servidor.
CRON_SECRET=
# Opcional: si = mostrar Redes sociales en Production; no = «Próximamente»; vacía = «Próximamente» solo en Production.
# No es una clave: se usa al armar la página (vite.config.ts, datos/bandera.js).
MKT_REDES_VISIBLE=

# --- 9. Webhooks de Make.com (Procesamiento de reportes e Historial) ---
VITE_MAKE_WEBHOOK_URL=
VITE_HISTORY_WEBHOOK_URL=
MAKE_WEBHOOK_URL=
HISTORY_WEBHOOK_URL=

# Configuración de Firebase (Realtime Database y Sincronización)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Tasa de cambio oficial / por defecto para consolidación GTQ -> USD
VITE_EXCHANGE_RATE_GTQ_USD=

# Credenciales Maestras de Acceso
VITE_MASTER_PASSWORD=
VITE_MASTER_GT_PASSWORD=
VITE_MASTER_SV_PASSWORD=
